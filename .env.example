# Copie para .env e preencha. O .env NUNCA deve ser commitado.

# ---------- MySQL / MariaDB ----------
# Use 127.0.0.1 em vez de localhost (evita o Node tentar IPv6)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aluguel_esportivo
DB_POOL_LIMIT=10

# Usuário que o APP usa. Só tem SELECT/INSERT/UPDATE/DELETE.
# O `npm run db:setup` cria esse usuário com a senha abaixo.
DB_USER=cl205220
DB_PASSWORD=o5rTgQlSQrTjcMy0

# Usuário ADMIN (root), usado só pelos comandos `npm run db:*` para criar banco e tabelas.
# No XAMPP o padrão é root sem senha; se você definiu uma senha, coloque aqui.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ---------- API de notificações (API 4 — a nossa, pasta api-notificacoes/) ----------
# Ligue com: npm run api:notificacoes
NOTIFICACOES_URL=http://127.0.0.1:3333
# Chave compartilhada entre o app e a API (mínimo 16 caracteres). Gere uma sua com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NOTIFICACOES_CHAVE=troque_por_uma_chave_gerada
NOTIFICACOES_TEMPO_LIMITE_MS=5000
